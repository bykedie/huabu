PORT=3102
DB_PATH=data/app.db
# Compose 默认把应用直接发布为公网 IP:3102；可在 h 管理面板修改宿主端口
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT=3102

# 生产环境务必分别改成至少 32 字节的随机值，例如：openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
# 仅首次创建管理员时填写到注册页；创建成功后可从 .env 删除并重启
ADMIN_SETUP_TOKEN=replace-with-a-different-random-secret
# 未做邮箱验证时建议保持 0，避免批量注册套取体验积分
WELCOME_POINTS=0

# 防止单个免费账号耗尽 SQLite 磁盘；按实际服务器容量调整
MAX_CANVASES_PER_USER=100
MAX_ASSETS_PER_USER=200
MAX_CANVAS_BYTES=2097152
MAX_USER_STORAGE_BYTES=20971520
# 每个来源 IP 在 15 分钟内最多成功注册次数
REGISTRATION_RATE_LIMIT=5

# OpenAI-compatible 中转站。地址应包含 /v1，但不要包含 /chat/completions
AI_BASE_URL=
AI_API_KEY=
AI_MODELS=gpt-4o-mini
# 生图端点固定为 https://www.bkbk.baby/v1；每位用户在账户设置中保存自己的密钥
AI_IMAGE_MODELS=GPT-image-2
AI_TIMEOUT_MS=120000
# 仅回收超过该时长的遗留 AI 预占；应至少比 AI_TIMEOUT_MS 多 10 秒
AI_PENDING_RECOVERY_MS=180000
# 单次中转响应最大字节数，防止异常上游耗尽服务端内存（默认 2 MiB）
AI_MAX_RESPONSE_BYTES=2097152
# 生图可能返回 base64，因此使用独立且更高的响应上限（默认 12 MiB）
AI_IMAGE_MAX_RESPONSE_BYTES=12582912

# OpenAI-compatible 视频中转站。地址应包含 /v1，但不要包含 /videos
AI_VIDEO_BASE_URL=
AI_VIDEO_API_KEY=
# 仅当视频中转返回不同域名的媒体 URL 时填写；多个精确 origin 用英文逗号分隔，不含路径
AI_VIDEO_MEDIA_ORIGINS=
# 多个模型用英文逗号分隔；留空表示仅通过管理后台配置
AI_VIDEO_MODELS=
# 每次成功生成视频扣除的固定整数积分
AI_VIDEO_POINTS=24
AI_VIDEO_TIMEOUT_MS=600000
# 前端轮询未完成视频任务的建议间隔（生产默认 2.5 秒）
AI_VIDEO_POLL_MS=2500
# 必须至少比 AI_VIDEO_TIMEOUT_MS 多 10 秒，默认多保留 60 秒
AI_VIDEO_PENDING_RECOVERY_MS=660000
# 单个视频上传或中转响应最大字节数（默认 64 MiB）
AI_VIDEO_MAX_RESPONSE_BYTES=67108864
# 每位用户的视频媒体总字节数；不得低于 AI_VIDEO_MAX_RESPONSE_BYTES（默认 512 MiB）
MAX_USER_MEDIA_BYTES=536870912

# 每 1000 token 扣除的整数积分。无 usage 时按保守估算结算
AI_INPUT_POINTS_PER_1K=1
AI_OUTPUT_POINTS_PER_1K=4
# 人工充值兑换比例：多少分人民币兑换 1 积分。默认 1 分 = 1 积分
CENTS_PER_POINT=1
# 展示给用户的付款方式、收款账号和备注要求；不要填写支付 API 密钥
TOPUP_INSTRUCTIONS=
